# Copia este archivo a ".env" y rellena tus propias claves.
# Ninguna de estas claves debe subirse al repositorio (.env está en .gitignore).

# Last.fm (álbumes) — gratis en https://www.last.fm/api/account/create
LASTFM_API_KEY=

# TMDb (películas) — gratis en https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# País para "dónde ver": código ISO 3166-1 (US, MX, ES, CO, AR, ...).
# Determina en qué plataformas de streaming se busca disponibilidad.
TMDB_WATCH_REGION=US

# Google Books (libros) — opcional, sube el límite de peticiones.
# https://console.cloud.google.com/apis/library/books.googleapis.com
GOOGLE_BOOKS_API_KEY=

# Google AdMob — App IDs y Unit IDs de https://apps.admob.com
# Si los dejas vacíos se usan los IDs de PRUEBA de Google (no generan ingresos).
ANDROID_ADMOB_APP_ID=
IOS_ADMOB_APP_ID=
ADMOB_BANNER_ANDROID=
ADMOB_BANNER_IOS=
ADMOB_INTERSTITIAL_ANDROID=
ADMOB_INTERSTITIAL_IOS=

# Google AdSense — solo se usa en la versión web/PWA de la app (en Android
# e iOS nativos se usa AdMob arriba). Se consiguen en https://adsense.google.com
# después de que Google apruebe el sitio. Mientras estén vacíos, no se
# muestra ningún anuncio en la versión web.
ADSENSE_CLIENT_ID=
ADSENSE_SLOT_ID=

# Formulario de feedback privado (llega solo a tu correo) — gratis en
# https://formspree.io. Crea un formulario y pega su URL, formato
# https://formspree.io/f/xxxxxxxx
FORMSPREE_ENDPOINT=

# Formulario de envío para bandas/artistas emergentes (llega solo a tu
# correo) — otro formulario gratis en https://formspree.io, aparte del de
# feedback, para no mezclar los dos tipos de mensaje.
BAND_SUBMISSION_ENDPOINT=

# EAS (para compilar con "eas build") — opcional en desarrollo local.
EAS_PROJECT_ID=

# URL de pago de la suscripción premium ($3/mes, sin anuncios).
# Hoy es solo un link (por ejemplo a un enlace de cobro recurrente de Wompi
# o ePayco en tu futura web — ver README sección 7).
# Mientras esté vacío, el botón de "Suscribirme" avisa que aún no está listo.
PREMIUM_CHECKOUT_URL=

# Link de pago de Wompi para el plan anual con descuento ($22.99 USD/año
# en vez de $36/año pagando mes a mes), como alternativa a la suscripción
# mensual.
PREMIUM_ANNUAL_CHECKOUT_URL=

# Link de pago único de Wompi para propinas/donaciones voluntarias.
TIP_CHECKOUT_URL=

# Tu ID de Amazon Associates (ej. "recosdiarias-20"), de
# https://afiliados.amazon.com (o https://affiliate-program.amazon.com si
# te inscribes en el programa de EE. UU., que es lo usual desde Colombia
# porque no hay un programa de afiliados propio para amazon.com.co). Se
# agrega como parámetro "tag" al botón "Comprar en Amazon" del libro del
# mes. Mientras esté vacío, el link igual funciona (lleva a la búsqueda en
# Amazon) pero sin generar comisión.
AMAZON_ASSOCIATE_TAG=

# --- Pago recurrente real (backend en /api) ---
# Ver db/schema.sql para crear las tablas en Supabase antes de usar esto.

# "sandbox" mientras probamos (sin plata real) — cambiar a "production"
# recién cuando todo el flujo esté confirmado funcionando.
WOMPI_ENV=sandbox

# Llaves de Wompi (Configuración -> Llaves API en comercios.wompi.co).
# La pública es segura de exponer en el navegador (suscribirse.html la
# pide a /api/wompi-public-config); la privada, el secreto de eventos y
# el de integridad NUNCA deben salir del servidor.
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=

# Secreto de integridad (prefijo test_integrity_/prod_integrity_, mismo
# lugar que las otras llaves) — Wompi lo exige para firmar cada cobro
# (evita que alguien altere el monto/referencia entre que se calcula y
# se cobra). Sin esto, cada cobro falla con "Firma de integridad
# requerida no enviada".
WOMPI_INTEGRITY_SECRET=

# Precios en pesos colombianos (Wompi cobra en COP). Ajusta si la tasa
# de cambio se mueve mucho.
WOMPI_MONTHLY_AMOUNT_COP=9900
WOMPI_ANNUAL_AMOUNT_COP=71900

# Supabase (Project Settings -> API Keys en supabase.com).
# SUPABASE_SERVICE_ROLE_KEY nunca debe salir del servidor tampoco.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cualquier texto largo al azar — protege /api/cron-charge-subscribers
# para que solo Vercel Cron pueda llamarlo. Configúralo también como
# variable de entorno del proyecto en Vercel (Settings -> Environment
# Variables) con el mismo valor.
CRON_SECRET=
